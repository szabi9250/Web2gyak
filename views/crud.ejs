<%- include("partials/header") %>

<main class="container">
    <h1>Süteményárak kezelése</h1>

    <table>
        <thead>
            <tr>
                <th>Azonosító</th>
                <th>Sütemény</th>
                <th>Ár (Ft)</th>
                <th>Egység</th>
            </tr>
        </thead>
        <tbody>
            <% arak.forEach(ar => { %>
                <tr>
                    <td><%= ar.id %></td>
                    <td><%= sutiNevek.get(ar.sutiid) ?? "Ismeretlen sütemény" %></td>
                    <td><%= ar.ertek %></td>
                    <td><%= ar.egyseg || "–" %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</main>

<%- include("partials/footer") %>