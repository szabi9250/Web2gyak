<%- include("partials/header") %>
    <h1>Sütemények árlistája</h1>
    <style>

        
    </style>
    <table>
        <thead>
            <tr>
                <th>Süti</th>
                <th>Tartalom</th>
                <th>Ár</th>
                <th>Egység</th>
            </tr>
        </thead>

        <tbody>
            <% sorok.forEach(sor => { %>
                <tr>
                    <td><%= sor.nev %></td>
                    <td><%= sor.tartalom %></td>
                    <td><%= sor.ar %></td>
                    <td><%= sor.egyseg %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
<%- include("partials/footer") %>