<%- include("partials/header") %>

<h1>Kezdőlap</h1>

<section class="wrapper style1">
    <div class="container">
        <div class="row">
            <section class="col-6 col-12-narrower">
                <div class="box post">
                    <a href="/database" class="image left" aria-label="Adatbázis">
                        <img src="/images/pic01.jpg" alt="">
                    </a>
                    <div class="inner">
                        <h3>Adatbázis</h3>
                        <p>Az adatbázis oldalon megtekintheted az elérhető süteményeket, a mentességi jelöléseiket, az árukat és az egységüket.</p>
                    </div>
                </div>
            </section>

            <section class="col-6 col-12-narrower">
                <div class="box post">
                    <a href="/contact" class="image left" aria-label="Kapcsolat">
                        <img src="/images/pic02.jpg" alt="">
                    </a>
                    <div class="inner">
                        <h3>Kapcsolat</h3>
                        <p>A Kapcsolat oldalon üzenetet küldhetsz az üzemeltetőknek.</p>
                    </div>
                </div>
            </section>
        </div>

        <div class="row">
            <section class="col-6 col-12-narrower">
                <div class="box post">
                    <a href="/messages" class="image left" aria-label="Üzenetek">
                        <img src="/images/pic03.jpg" alt="">
                    </a>
                    <div class="inner">
                        <h3>Üzenetek</h3>
                        <p>A bejelentkezett felhasználók itt olvashatják az üzemeltetőknek küldött üzeneteket.</p>
                    </div>
                </div>
            </section>

            <section class="col-6 col-12-narrower">
                <div class="box post">
                    <a href="/diagram" class="image left" aria-label="Diagram">
                        <img src="/images/pic04.jpg" alt="">
                    </a>
                    <div class="inner">
                        <h3>Diagram</h3>
                        <p>A diagram megmutatja, hogy típusonként hány sütemény szerepel az adatbázisban.</p>
                    </div>
                </div>
            </section>
        </div>

        <div class="row">
            <section class="col-6 col-12-narrower">
                <div class="box post">
                    <a href="/crud" class="image left" aria-label="Süteményárak kezelése">
                        <img src="/images/pic03.jpg" alt="">
                    </a>
                    <div class="inner">
                        <h3>CRUD</h3>
                        <p>Az adminisztrátorok itt listázhatják, felvehetik, módosíthatják és törölhetik a süteményárakat.</p>
                    </div>
                </div>
            </section>

            <section class="col-6 col-12-narrower">
                <div class="box post">
                    <a href="/admin" class="image left" aria-label="Admin menü">
                        <img src="/images/pic04.jpg" alt="">
                    </a>
                    <div class="inner">
                        <h3>Admin menü</h3>
                        <p>Az adminisztrátorok számára elérhető oldal.</p>
                    </div>
                </div>
            </section>
        </div>
    </div>
</section>

<%- include("partials/footer") %>